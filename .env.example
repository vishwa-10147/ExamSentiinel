# ExamSentinel AWS Production Environment Configuration

# --------------------------
# General Settings
# --------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --------------------------
# Security
# --------------------------
# MUST CHANGE: Generate a strong, random 64-character secret key for JWT encryption.
SECRET_KEY=change_me_to_a_long_random_string_for_production
ALGORITHM=HS256

# --------------------------
# Networking & CORS
# --------------------------
# Replace with your actual AWS subdomains (e.g., https://exams.myuniversity.edu)
CORS_ORIGINS=["https://exams.myuniversity.edu", "https://api.exams.myuniversity.edu"]
NEXT_PUBLIC_API_URL=https://api.exams.myuniversity.edu/api

# --------------------------
# Database (Amazon RDS - PostgreSQL)
# --------------------------
# The Async connection string for FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:your_password@your-rds-endpoint.aws.com:5432/examsentinel
# The Sync connection string for Alembic Migrations
SYNC_DATABASE_URL=postgresql://postgres:your_password@your-rds-endpoint.aws.com:5432/examsentinel

# --------------------------
# Caching & Real-time (Amazon ElastiCache - Redis)
# --------------------------
REDIS_URL=redis://your-elasticache-endpoint.aws.com:6379/0

# --------------------------
# External Sandbox Images (Optional Overrides)
# --------------------------
# SANDBOX_PYTHON_IMAGE=python:3.11-slim
# SANDBOX_NODE_IMAGE=node:20-alpine
# SANDBOX_SQLITE_IMAGE=nouchka/sqlite3:latest
