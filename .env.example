# ExamSentinel environment variables - PLACEHOLDERS ONLY. Never commit real values.
#
# Where each variable goes:
#   backend/.env         the API when run locally (backend/app/core/config.py loads it; real env vars win)
#   frontend/.env.local  the web app (only NEXT_PUBLIC_* values; they reach the browser - never secrets)
#   .env (repo root)     docker-compose.yml (the full stack in Docker) - variable substitution only
#   production           ECS task definitions + AWS Secrets Manager; see .env.production.example
# Commented lines show the default. Every variable below is read by the code.

# ================================================================ backend/.env

# ---------------------------------------------------------------- core
ENVIRONMENT=development          # "production" turns on the start-up safety checks
DEBUG=true                       # must be false in production
LOG_LEVEL=INFO
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Browser sessions are httpOnly cookies. COOKIE_SECURE defaults to true in production.
# COOKIE_SECURE=
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ---------------------------------------------------------------- web addresses
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]   # the web app's origin(s)
FRONTEND_URL=http://localhost:3000       # links in e-mails, SSO redirects
PUBLIC_API_URL=http://localhost:8000     # SSO callback URLs

# ---------------------------------------------------------------- client IP and limits
# Proxies allowed to identify the client (X-Forwarded-For). Production: the load balancer's network.
# FORWARDED_ALLOW_IPS=127.0.0.1
# CLIENT_IP_HEADER=                      # only behind a proxy that sets and sanitises it
# LOGIN_RATE_LIMIT_PER_IP=300            # sign-ins per minute per IP (a lab shares one address)

# ---------------------------------------------------------------- database / cache
DATABASE_URL=sqlite+aiosqlite:///./examsentinel_dev.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/examsentinel
# DB_POOL_SIZE=5                         # per worker process; tasks x workers x (size+overflow) < max_connections
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# SQL_ECHO=false                         # log every SQL statement (diagnosis only)
REDIS_URL=redis://localhost:6379/0       # optional for one process; required for several

# ---------------------------------------------------------------- code execution (self-hosted Piston)
# docker compose -f docker-compose.piston.yml up -d && python scripts/install_piston_runtimes.py
# Never point this at the public emkc.org API (whitelist-only; production refuses it).
PISTON_URL=http://127.0.0.1:2000/api/v2/execute
# PISTON_MAX_CONCURRENCY=16              # engine calls per API process
# JUDGE_WORKERS=8                        # concurrent judge jobs per API process
# SUBMIT_WAIT_SECONDS=20                 # Submit waits this long for a verdict, then answers 202

# ---------------------------------------------------------------- AI (optional)
# Server-side webcam analysis (YOLO needs the AI build: requirements-ai.txt / WITH_AI=true)
CV_MODEL_PATH=../ai/models/yolo11n.pt
# PHONE_CONFIDENCE_THRESHOLD=0.45
# PERSON_CONFIDENCE_THRESHOLD=0.5
# Interview speech-to-text model: tiny | base | small ...
# WHISPER_MODEL_SIZE=base
# Advisory grade suggestions and question generation; empty = off
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------- e-mail (password-reset codes)
ENABLE_EMAILS=false
# Any one provider: Brevo or SendGrid (HTTPS), or SMTP.
BREVO_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=                             # From address (defaults to SMTP_USER)

# ---------------------------------------------------------------- evidence storage (optional)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=                         # private S3 bucket; empty = webcam snapshots are not kept
# EVIDENCE_URL_TTL_SECONDS=900           # lifetime of presigned evidence links

# ---------------------------------------------------------------- single sign-on (optional; unset = button hidden)
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
# SSO_MICROSOFT_CLIENT_ID=
# SSO_MICROSOFT_CLIENT_SECRET=
# SSO_MICROSOFT_TENANT=organizations
# SSO_OIDC_ISSUER=https://idp.example.edu
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_NAME=University Login
SSO_ALLOWED_DOMAINS=
SSO_AUTO_PROVISION=false

# ---------------------------------------------------------------- first admin (production: created by `migrate`)
ADMIN_EMAIL=
ADMIN_PASSWORD=                          # 12+ characters

# ---------------------------------------------------------------- operations (container / production)
# WEB_CONCURRENCY=2                      # uvicorn worker processes per container
# GRACEFUL_SHUTDOWN_SECONDS=20           # finish requests in flight on SIGTERM
# RUN_MIGRATIONS_ON_START=false          # single-instance hosts only
# METRICS_ENABLED=                       # CloudWatch EMF metric lines; default on in production
# METRICS_INTERVAL_SECONDS=60

# ================================================================ frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000    # required for production builds
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"turn:turn.example.edu:3478","username":"...","credential":"..."}]  # TURN for interviews

# ================================================================ .env (root) for docker-compose.yml only
# Do not copy this whole file there: the backend/.env values above (SQLite DATABASE_URL, PISTON_URL on
# 127.0.0.1) would be passed into the containers. SECRET_KEY is enough; the stack has defaults for the rest.
# If you set POSTGRES_PASSWORD, also set DATABASE_URL=postgresql+asyncpg://postgres:<password>@postgres:5432/examsentinel
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=examsentinel
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# REDIS_PORT=6379
