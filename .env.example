# Environment Configuration for ExamSentinel

# General Environment
ENVIRONMENT=development
PROJECT_NAME="ExamSentinel"
DEBUG=True
LOG_LEVEL=INFO

# Security & JWT Auth
# Generate secure key using: openssl rand -hex 32
SECRET_KEY=examsentinel_super_secret_jwt_key_for_dev_change_in_production_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=examsentinel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/examsentinel
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/examsentinel

# Redis (Cache, Pub/Sub & Queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Network & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Frontend Next.js Public Config
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Sandbox Worker Configuration
SANDBOX_REDIS_QUEUE=examsentinel:sandbox:queue
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_TIMEOUT_SEC=5.0

# Computer Vision & Proctoring Config
CV_MODEL_PATH=ai/models/yolo11n.pt
SNAPSHOT_INTERVAL_SECONDS=10
PHONE_CONFIDENCE_THRESHOLD=0.60
FACE_ABSENCE_GRACE_SECONDS=10

# Third-party Integrations (Optional in Dev)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
WHISPER_MODEL_SIZE=base
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
