# ExamSentinel environment variables — PLACEHOLDERS ONLY.
#
# Local development: copy to backend/.env (git-ignored). backend/app/core/config.py
# loads it; real environment variables win. Never commit real values.
# Production (docker-compose.prod.yml): see .env.production.example.

# ---------------------------------------------------------------- core
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------- networking
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# Frontend (frontend/.env.local). Only NEXT_PUBLIC_* values reach the browser — never put secrets in them.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- database / cache
# Local development: SQLite file in backend/ (the schema is created on startup).
DATABASE_URL=sqlite+aiosqlite:///./examsentinel_dev.db
# PostgreSQL (docker-compose / production; Alembic migrations are Postgres-only):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/examsentinel
# SYNC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/examsentinel
# Optional; every Redis caller has a fallback.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- code execution (self-hosted Piston)
# docker compose -f docker-compose.piston.yml up -d && python scripts/install_piston_runtimes.py
# Never point this at the public emkc.org API (whitelist-only).
PISTON_URL=http://localhost:2000/api/v2/execute
PISTON_MAX_CONCURRENCY=8

# ---------------------------------------------------------------- AI proctoring (optional)
CV_MODEL_PATH=../ai/models/yolo11n.pt
PHONE_CONFIDENCE_THRESHOLD=0.35
PERSON_CONFIDENCE_THRESHOLD=0.5
WHISPER_MODEL_SIZE=base
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# ---------------------------------------------------------------- email (optional)
ENABLE_EMAILS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
BREVO_API_KEY=

# ---------------------------------------------------------------- evidence storage (optional)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
EVIDENCE_URL_TTL_SECONDS=300

# ---------------------------------------------------------------- single sign-on (optional; unset = button hidden)
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
# SSO_MICROSOFT_CLIENT_ID=
# SSO_MICROSOFT_CLIENT_SECRET=
# SSO_MICROSOFT_TENANT=organizations
# SSO_OIDC_ISSUER=https://idp.example.edu
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_NAME=University Login
SSO_ALLOWED_DOMAINS=
SSO_AUTO_PROVISION=false

# ---------------------------------------------------------------- first admin (production seeding)
ADMIN_EMAIL=
ADMIN_PASSWORD=
