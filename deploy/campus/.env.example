# deploy/campus/.env - setup.sh writes the required part with random secrets. Keep it private.

# ---- required (setup.sh) ----
SERVER_NAME=exam.college.edu            # the host name students type; must match the certificate
PUBLIC_URL=https://exam.college.edu     # https://SERVER_NAME (add :port only if not 443)
SECRET_KEY=                             # openssl rand -hex 32
POSTGRES_PASSWORD=                      # openssl rand -hex 24
ADMIN_EMAIL=                            # first admin, created once
ADMIN_PASSWORD=                         # 12+ characters; change after first sign-in

# ---- capacity ----
WEB_CONCURRENCY=4                       # API worker processes (about one per 2 CPU cores)
# LOGIN_RATE_LIMIT_PER_IP=300           # sign-ins per minute per address (raise if a lab shares one NAT address)
WITH_AI=false                           # true: server-side phone/person detection and interview
                                        # transcription (bigger image, more CPU; then rebuild)

# ---- backups (./backups) ----
BACKUP_HOUR=2                           # nightly dump at 02:00 server time
BACKUP_KEEP_DAYS=14

# ---- e-mail for password-reset codes (any one) ----
ENABLE_EMAILS=false
SMTP_HOST=                              # campus SMTP relay works without internet
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@college.edu
# BREVO_API_KEY=
# SENDGRID_API_KEY=

# ---- optional, need internet ----
# GEMINI_API_KEY=                       # advisory AI grade suggestions
# SSO_MICROSOFT_CLIENT_ID=              # single sign-on (also Google / any OIDC; see .env.example at the repo root)
# SSO_MICROSOFT_CLIENT_SECRET=
# SSO_MICROSOFT_TENANT=
# SSO_ALLOWED_DOMAINS=college.edu
# NEXT_PUBLIC_ICE_SERVERS=              # TURN server for interviews across restrictive networks (rebuild)

# ---- ports (normally leave as is) ----
# HTTP_PORT=80
# HTTPS_PORT=443
