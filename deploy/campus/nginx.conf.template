# One host name for the whole application: /api (and its WebSockets) to the backend, everything
# else to the web app. ${SERVER_NAME} is filled in from .env when the container starts.

resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

proxy_read_timeout 120s;        # Submit waits up to 20 s; WebSockets stay open with pings
proxy_send_timeout 120s;
client_max_body_size 25m;       # webcam frames, interview audio, CSV imports

# Plain HTTP: Let's Encrypt challenges, otherwise redirect to HTTPS (the webcam needs HTTPS).
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 ${PUBLIC_URL}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    location /api/ {
        set $backend backend:8000;
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        set $frontend frontend:3000;
        proxy_pass http://$frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
