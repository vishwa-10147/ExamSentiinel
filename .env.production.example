# Production settings for docker-compose.prod.yml (copy to .env.production —
# git-ignored — and fill in). On ECS, put these in the task definition and
# the secrets in AWS Secrets Manager instead.

SECRET_KEY=                 # openssl rand -hex 32
POSTGRES_PASSWORD=          # used by the bundled db service
# DATABASE_URL=postgresql+asyncpg://USER:PASS@your-rds-endpoint:5432/examsentinel   # when using RDS
# REDIS_URL=rediss://your-elasticache-endpoint:6379/0                            # when using ElastiCache

CORS_ORIGINS=https://exam.example.edu
NEXT_PUBLIC_API_URL=https://api.exam.example.edu
NEXT_PUBLIC_SITE_URL=https://exam.example.edu

# First admin, created once by `migrate` if no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=             # 12+ characters

# Private S3 bucket for webcam evidence (IAM role grants access; no keys here).
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

WITH_AI=true                # build the backend with YOLO phone/person detection
WEB_CONCURRENCY=2
